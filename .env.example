# Supabase configuration (optional).
# Without these, the app runs in local-only mode (no login / no cross-device sync).
#
# Find both values in your Supabase project:
#   Project Settings → API → Project URL  and  Project API keys → anon / public
#
# The anon key is safe to expose in a client bundle; access is enforced by
# Row Level Security (see supabase/schema.sql).
#
# Local dev: copy this file to `.env` and fill in the values.
# GitHub Pages: add the same two as repository Variables (Settings → Secrets and
#   variables → Actions → Variables) so the deploy workflow can inject them.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
